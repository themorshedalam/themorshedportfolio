# Cloudflare Pages — security + caching headers

# Security headers for all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache all video files aggressively (1 year)
/projects/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Cache all images/GIFs aggressively (1 year)
/projects/*.png
  Cache-Control: public, max-age=31536000, immutable
/projects/*.gif
  Cache-Control: public, max-age=31536000, immutable
/projects/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# Cache Next.js static chunks aggressively (1 year)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — short cache (so deploys show quickly)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Compress responses
/*
  Content-Encoding: br
