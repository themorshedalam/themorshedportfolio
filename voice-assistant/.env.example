# ---------------------------------------------------------------------------
# Real-Time Natural Voice AI Assistant — environment variables
#
# Copy this file to `.env` and fill in the values.
# NEVER commit your real `.env` file.
#
# The permanent API key (and any other credentials) MUST stay on the server.
# These values are read by:
#   - src/app/api/realtime/session/route.ts
#   - mini-services/voice-session/index.ts
# ---------------------------------------------------------------------------

# Secret used to sign short-lived session tokens. Use a long random value
# in production, e.g. `openssl rand -hex 32`. The SAME value MUST be set on
# both the Next.js app and the voice-session mini-service.
REALTIME_TOKEN_SECRET=dev-only-realtime-token-secret-please-override-in-production

# Voice identifier — must be one of the supported z-ai-web-dev-sdk TTS
# voices. For the male voice requirement, recommended options are:
#   kazi      — clear, standard, organized male (35-40, default)
#   douji     — natural, fluent male (30-40)
#   xiaochen  — calm, professional male (45+)
#   jam       — British gentleman, higher-pitched
REALTIME_VOICE=xiaochen

# Display-only model name surfaced to the UI.
# (The actual model used internally by z-ai-web-dev-sdk is fixed by the SDK.)
REALTIME_MODEL=gpt-4o-mini

# Optional: override the default system prompt.
# REALTIME_SYSTEM_PROMPT="You are a natural, friendly male voice AI assistant…"

# Optional: enable any auth provider you wire into src/lib/auth.ts.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
